\RequirePackage{mathtools}
% (amsmath vem com mathtools; unicode-math já foi carregado)

% Conjuntos e operadores
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\E}{\mathbb{E}}
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\Cov}{Cov}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator{\tr}{tr}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\newcommand{\T}{^{\mkern-1.5mu\mathsf{T}}} % transposta (⊤ falta na Fira Math)
\newcommand{\eqdef}{\coloneqq}       % definição
\newcommand{\iid}{\overset{\text{iid}}{\sim}}

% Convenção tipográfica do curso:
%   escalares: itálico (x, \beta)   vetores: negrito itálico (\vx, \vbeta)
%   matrizes: negrito reto (\mX)    conjuntos/distribuições: caligráfico
\newcommand{\vect}[1]{\symbfit{#1}}
\newcommand{\mat}[1]{\symbf{#1}}
\newcommand{\vx}{\vect{x}}
\newcommand{\vy}{\vect{y}}
\newcommand{\vw}{\vect{w}}
\newcommand{\vb}{\vect{b}}
\newcommand{\ve}{\vect{\varepsilon}}
\newcommand{\vbeta}{\vect{\beta}}
\newcommand{\vtheta}{\vect{\theta}}
\newcommand{\hvbeta}{\hat{\vect{\beta}}}
\newcommand{\mX}{\mat{X}}
\newcommand{\mI}{\mat{I}}
\newcommand{\mA}{\mat{A}}

% Aprendizado de máquina
\newcommand{\loss}{\mathcal{L}}          % função de perda
\newcommand{\data}{\mathcal{D}}          % conjunto de dados
\newcommand{\dtreino}{\data_{\text{treino}}}
\newcommand{\dvalid}{\data_{\text{valid}}}
\newcommand{\dteste}{\data_{\text{teste}}}
\newcommand{\hf}{\hat{f}}               % função estimada
\newcommand{\lr}{\eta}                  % taxa de aprendizado
\newcommand{\MSE}{\operatorname{EQM}}   % erro quadrático médio
\newcommand{\grad}{\nabla}
\newcommand{\dd}{\mathop{}\!\mathrm{d}} % diferencial
\newcommand{\pder}[2]{\frac{\partial #1}{\partial #2}}

% ---------------------------------------------------------------------
% Código
% ---------------------------------------------------------------------
% outputdir=build casa com o -outdir=build do latexmk (minted 2.x).
% No minted 3.x a opção é desnecessária e inofensiva.
\RequirePackage[outputdir=build]{minted}
\setminted{
  fontsize=\small,
  breaklines,
  autogobble,
  tabsize=4,
  style=friendly,
}
\newminted[codigo]{python}{}                        % \begin{codigo} ... \end{codigo}
\newmintinline[py]{python}{}                         % \py{np.dot(a, b)}
\newcommand{\pkg}[1]{\textsf{#1}}                    % nomes de bibliotecas
\newcommand{\cmd}[1]{\texttt{#1}}

% Link "Abrir no Colab" para um notebook do repositório
%   \colab{aulas/01-python-numpy-jax/notebooks/01_demo.ipynb}{Demonstração}
\newcommand{\colaburl}[1]{https://colab.research.google.com/github/\tmlrepo/blob/\tmlbranch/#1}
\newcommand{\colab}[2]{%
  \href{\colaburl{#1}}{\textcolor{tmlaccent}{\textsf{\small$\blacktriangleright$\,Abrir no Colab:}}~#2}}

