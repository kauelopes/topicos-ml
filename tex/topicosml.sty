\definecolor{tmlprimary}{HTML}{23373B}   % azul petróleo escuro
\definecolor{tmlaccent}{HTML}{EB811B}    % laranja
\definecolor{tmlgreen}{HTML}{14B03D}
\definecolor{tmlblue}{HTML}{2A6F97}
\definecolor{tmlred}{HTML}{B22234}
