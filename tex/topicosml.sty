% ---------------------------------------------------------------------
% Caixas pedagógicas (funcionam em beamer e em texto corrido)
% ---------------------------------------------------------------------
\RequirePackage[most,minted]{tcolorbox}
\tcbset{
  tmlbase/.style={
    enhanced, breakable, boxrule=0pt, arc=1pt, left=6pt, right=6pt,
    top=4pt, bottom=4pt, fonttitle=\sffamily\bfseries\small,
    colback=tmlgray, borderline west={3pt}{0pt}{#1},
    coltitle=#1, colbacktitle=tmlgray, attach title to upper={\par\smallskip},
  }
}
% Ponte com econometria/estatística — a "marca" do curso
\newtcolorbox{conexao}[1][]{tmlbase=tmlblue, title={Conexão com a Econometria}, #1}
% Definição formal
\newtcolorbox{definicao}[1][]{tmlbase=tmlprimary, title={Definição}, #1}
% Armadilhas comuns
\newtcolorbox{atencao}[1][]{tmlbase=tmlred, title={Atenção}, #1}
% Intuição / ideia-chave
\newtcolorbox{intuicao}[1][]{tmlbase=tmlaccent, title={Intuição}, #1}
% Exemplo econômico
\newtcolorbox{exemplo}[1][]{tmlbase=tmlgreen, title={Exemplo}, #1}

